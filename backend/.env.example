# ---- Povinné
# Náhodný dlhý reťazec (napr. výstup: openssl rand -hex 32)
SECRET_KEY=zmente-ma-na-nahodny-dlhy-retazec
# Prvý administrátor – vytvorí sa pri prvom štarte, ak v databáze nie je žiadny používateľ
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=zmente-heslo
ADMIN_NAME=Administrátor

# ---- Databáza (pre docker compose)
POSTGRES_USER=app
POSTGRES_PASSWORD=zmente-heslo-db
POSTGRES_DB=naklady

# ---- Adresa aplikácie (pre Google OAuth presmerovanie)
APP_BASE_URL=http://localhost:8000
# Port na hostiteľovi; v produkcii za Caddy použite 127.0.0.1:8000
APP_PORT=8000
# V produkcii s HTTPS nastavte true
COOKIE_SECURE=false
# Doména pre produkčné HTTPS (docker-compose.prod.yml)
DOMAIN=naklady.example.sk

# ---- Claude API (čítanie bločkov a faktúr, keď eKasa nepomôže). Bez kľúča sa údaje zadávajú ručne.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---- Google (bežný Gmail účet) – OAuth klient typu "Web application", pozri README
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- eKasa (Finančná správa SR)
EKASA_ENABLED=true
EKASA_URL=https://ekasa.financnasprava.sk/mdu/api/v1/opd/receipt/find

# ---- Cloudflare Tunnel (docker-compose.tunnel.yml) – token z Cloudflare Zero Trust → Networks → Tunnels
TUNNEL_TOKEN=
